{
  "name": "visiongo-website",
  "version": "1.0.0",
  "description": "Official website for VISIONGO - Industrial Vision Intelligence (visiongo.app)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && node scripts/generate-routes.js && node scripts/verify-seo.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json",
    "test:seo": "node scripts/verify-seo.js",
    "preview": "vite preview",
    "deploy": "wrangler deploy",
    "build:server": "vite build --ssr worker/index.ts --outDir server-build",
    "start:server": "node --env-file=.env deploy/server.mjs",
    "deploy:cn": "deploy/deploy-cn.sh",
    "test": "npm run build && npm run test:worker",
    "test:worker": "node scripts/worker.test.mjs && node scripts/organizations.test.mjs && node scripts/deploy.test.mjs",
    "test:browser": "node scripts/browser-smoke.mjs"
  },
  "keywords": [
    "industrial-vision",
    "machine-vision",
    "visionstudio",
    "visionruntime",
    "visionedge",
    "visioncloud"
  ],
  "author": "VISIONGO Engineering",
  "license": "UNLICENSED",
  "dependencies": {
    "lucide-react": "^1.76.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261119.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.7.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wrangler": "^4.165.0"
  }
}
